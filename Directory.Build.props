<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    所有项目共用的构建配置。

    EmbySystemDir = 已安装的 Emby Server 的 system 目录。Emby 是「部署好的应用」而不是
    NuGet 包，所以插件在编译期直接引用这个目录里的程序集
    （MediaBrowser.Common.dll / MediaBrowser.Controller.dll / MediaBrowser.Model.dll /
      Emby.Web.GenericEdit.dll ...），因此构建不需要任何私有源。

    解析顺序：
      1. 命令行：  dotnet build -p:EmbySystemDir="C:\Users\you\AppData\Roaming\Emby-Server\system"
      2. 环境变量：EMBY_SYSTEM_DIR
      3. 常见默认安装位置（Windows / Linux，取第一个真的放着 MediaBrowser.Common.dll 的目录）

    怎么找到这个目录：
      Windows：%APPDATA%\Emby-Server\system
               （也可在 Emby 控制台 → 高级 → 关于，或日志 embyserver.txt 的启动行里看到路径）
      Linux：  /opt/emby-server/system 或 /var/lib/emby/system

    完全找不到时，确保 Emby 程序集存在的两个目标会给出中文报错并中止构建，
    而不是让编译器丢出一堆看不懂的 CS0246。

    产物与中间文件都留在仓库自己的 artifacts/ 下（已 gitignore），
    不污染机器级的 .NET/NuGet 状态。
  -->

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <BaseOutputPath>$(RepoRoot)artifacts/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(RepoRoot)artifacts/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EmbySystemDir)' == '' and '$(EMBY_SYSTEM_DIR)' != ''">
    <EmbySystemDir>$(EMBY_SYSTEM_DIR)</EmbySystemDir>
  </PropertyGroup>

  <!-- 常见安装位置探测：以 MediaBrowser.Common.dll 是否真的存在为准。 -->
  <PropertyGroup>
    <EmbySystemDir Condition="'$(EmbySystemDir)' == '' and '$(APPDATA)' != '' and Exists('$(APPDATA)\Emby-Server\system\MediaBrowser.Common.dll')">$(APPDATA)\Emby-Server\system</EmbySystemDir>
    <EmbySystemDir Condition="'$(EmbySystemDir)' == '' and '$(HOME)' != '' and Exists('$(HOME)/.config/emby-server/system/MediaBrowser.Common.dll')">$(HOME)/.config/emby-server/system</EmbySystemDir>
    <EmbySystemDir Condition="'$(EmbySystemDir)' == '' and Exists('/opt/emby-server/system/MediaBrowser.Common.dll')">/opt/emby-server/system</EmbySystemDir>
    <EmbySystemDir Condition="'$(EmbySystemDir)' == '' and Exists('/var/lib/emby/system/MediaBrowser.Common.dll')">/var/lib/emby/system</EmbySystemDir>
  </PropertyGroup>

  <Target Name="EnsureEmbySystemDir"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(EmbySystemDir)' == ''">
    <Error Code="EMBY001"
           Text="找不到 Emby 服务端程序集目录。请用命令行参数指定：-p:EmbySystemDir=&quot;&lt;Emby 的 system 目录&gt;&quot;，或设置环境变量 EMBY_SYSTEM_DIR。Windows 常见位置：%APPDATA%\Emby-Server\system；Linux 常见位置：/opt/emby-server/system 或 /var/lib/emby/system。" />
  </Target>

  <Target Name="EnsureEmbyAssemblies"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(EmbySystemDir)' != '' and !Exists('$(EmbySystemDir)/MediaBrowser.Common.dll')">
    <Error Code="EMBY002"
           Text="EmbySystemDir 指向的目录里没有 MediaBrowser.Common.dll：$(EmbySystemDir)。请确认它指向 Emby 安装目录下的 system 子目录（Windows 默认 %APPDATA%\Emby-Server\system）。" />
  </Target>

</Project>
